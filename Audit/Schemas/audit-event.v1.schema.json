{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jozirunner.local/schemas/audit-event.v1.schema.json",
  "title": "Jozi Runner AI pipeline audit event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actionId", "timestampUtc", "actor", "provider", "operation", "status", "previousRecordHash", "recordHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "actionId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": ["string", "null"] },
    "parentActionId": { "type": ["string", "null"] },
    "assetId": { "type": ["string", "null"] },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "actor": { "type": "string" },
    "provider": { "type": "string" },
    "operation": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "authenticationType": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "approvalRequired": { "type": "boolean" },
    "approvalStatus": { "type": ["string", "null"] },
    "approvedBy": { "type": ["string", "null"] },
    "approvalTimestampUtc": { "type": ["string", "null"], "format": "date-time" },
    "startTimestampUtc": { "type": ["string", "null"], "format": "date-time" },
    "finishTimestampUtc": { "type": ["string", "null"], "format": "date-time" },
    "durationMilliseconds": { "type": ["integer", "null"], "minimum": 0 },
    "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
    "cachedInputTokens": { "type": ["integer", "null"], "minimum": 0 },
    "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
    "totalTokens": { "type": ["integer", "null"], "minimum": 0 },
    "tokenSource": { "type": ["string", "null"] },
    "estimatedCost": { "type": ["number", "null"], "minimum": 0 },
    "actualCost": { "type": ["number", "null"], "minimum": 0 },
    "currency": { "type": ["string", "null"] },
    "costType": { "enum": ["api-actual-from-usage", "api-estimate", "subscription-estimate", "fixed-credit-cost", "free-local-operation", "unknown"] },
    "pricingVersion": { "type": ["string", "null"] },
    "meshyBalanceBefore": { "type": ["number", "null"] },
    "meshyBalanceAfter": { "type": ["number", "null"] },
    "meshyCreditsConsumed": { "type": ["number", "null"], "minimum": 0 },
    "estimatedMeshyCredits": { "type": ["number", "null"], "minimum": 0 },
    "filesRead": { "type": "array", "items": { "type": "string" } },
    "filesCreated": { "type": "array", "items": { "type": "string" } },
    "filesModified": { "type": "array", "items": { "type": "string" } },
    "commandsExecuted": { "type": "array", "items": { "type": "string" } },
    "gitCommitBefore": { "type": ["string", "null"] },
    "gitCommitAfter": { "type": ["string", "null"] },
    "promptHash": { "type": ["string", "null"] },
    "resultHash": { "type": ["string", "null"] },
    "previousRecordHash": { "type": ["string", "null"] },
    "recordHash": { "type": "string" },
    "errorCode": { "type": ["string", "null"] },
    "redactedErrorMessage": { "type": ["string", "null"] },
    "rawEventFilePath": { "type": ["string", "null"] }
  }
}
